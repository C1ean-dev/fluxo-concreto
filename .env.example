# ========================================================
# Banco de Dados (PostgreSQL / Railway ou SQLite)
# ========================================================
# No Railway, a variável DATABASE_URL é injetada automaticamente ao adicionar o plugin PostgreSQL.
# Se DATABASE_URL ou PGHOST estiver definido, o servidor conecta automaticamente ao PostgreSQL.
# Se não for informado, o servidor utiliza SQLite localmente (database.sqlite).
#
# DATABASE_URL=postgresql://postgres:senha@host:5432/railway
# Ou parâmetros individuais:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=sua_senha
# PGDATABASE=railway
# PGSSLMODE=disable # omita ou use 'require' para conexões na nuvem

# ========================================================
# Porta do Servidor (Railway define PORT automaticamente)
# ========================================================
# PORT=3000

# ========================================================
# Inteligência Artificial (OpenRouter)
# ========================================================
# Chave da OpenRouter usada pelo chat/resumo/resposta com IA
OPENROUTER_API_KEY=sua_chave_aqui

# Modelo usado nas chamadas para a OpenRouter
OPENROUTER_MODEL=openrouter/free

# Indica se a conta OpenRouter usa Zero Data Retention
OPENROUTER_ZDR_ENABLED=false

# URL do site enviada opcionalmente para a OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000

# Nome da aplicacao enviado opcionalmente para a OpenRouter
OPENROUTER_APP_NAME=ConcretoProjetado

# Tempo limite das chamadas de IA
OPENROUTER_TIMEOUT_SECONDS=60

# Maximo de tokens gerados pela IA por resposta
OPENROUTER_MAX_TOKENS=15000

# Criatividade da IA; valores menores deixam respostas mais objetivas
OPENROUTER_TEMPERATURE=0.2

# Quantidade maxima de campanhas enviada como contexto para IA
AI_CONTEXT_CAMPAIGN_LIMIT=12

# Quantidade maxima de destinatarios enviada como contexto para IA
AI_CONTEXT_RECIPIENT_LIMIT=80

# Quantidade maxima de respostas enviada como contexto para IA
AI_CONTEXT_REPLY_LIMIT=80

# Maximo de caracteres de corpo de e-mail por item no contexto da IA
AI_CONTEXT_BODY_CHARS=700

# ========================================================
# Autenticação via Magic Link & OTP (Resend)
# ========================================================
# Habilita o login por e-mail. Desativado por padrão, inclusive com Resend configurado.
# Para habilitar no Railway, altere para true.
AUTH_EMAIL_ENABLED=false

# Chave da API Resend (gerada em resend.com/api-keys)
RESEND_API_KEY=sua_chave_resend_aqui

# Remetente de e-mail (usar onboarding@resend.dev para testes ou domínio verificado no Resend)
RESEND_FROM_EMAIL=Concreto Projetado <onboarding@resend.dev>

# Domínio corporativo restrito para logins
AUTH_ALLOWED_DOMAIN=falcaobauer.com.br

